R"mcp({
  "fields": {
    "address":{"type":"string","minLength":1,"maxLength":20,"description":"Exact runtime address as decimal/hex text; never a JSON number."},
    "module":{"type":"string","minLength":1,"maxLength":1024},
    "occurrence":{"type":"integer","minimum":1,"maximum":65536,"default":1},
    "size":{"type":"integer","minimum":4,"maximum":16384,"description":"Optional byte bound; known ELF function sizes are inferred. Stripped functions use an explicitly reported bounded window."},
    "offset":{"type":"integer","minimum":0,"maximum":2000000,"default":0},
    "limit":{"type":"integer","minimum":1,"maximum":1024,"default":128},
    "query":{"type":"string","maxLength":2048},
    "scan_mb":{"type":"integer","minimum":1,"maximum":256,"default":32},
    "timeout_ms":{"type":"integer","minimum":50,"maximum":10000,"default":2000},
    "refresh":{"type":"boolean","default":false},
    "cursor":{"type":"string","minLength":1,"maxLength":96,"description":"Opaque continuation from the same process and query; never invent or reuse after target restart."},
    "scope":{"type":"string","enum":["module","process","ranges"]},
    "ranges":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"object","properties":{"start":{"type":"string","minLength":1,"maxLength":20},"end":{"type":"string","minLength":1,"maxLength":20}},"required":["start","end"],"additionalProperties":false}},
    "encoding":{"type":"string","enum":["auto","utf8","utf16le","ascii"],"default":"auto"},
    "include_il2cpp":{"type":"boolean","default":false,"description":"Also resolve checked IL2CPP owner/field candidates; missing runtime capabilities are returned separately."},
    "object_address":{"type":"string","minLength":1,"maxLength":20},
    "field":{"type":"string","minLength":1,"maxLength":1024,"description":"Exact instance field; Declaring.Type::name disambiguates inherited hidden fields."},
    "work_limit":{"type":"integer","minimum":100,"maximum":1000000,"default":100000},
    "previous":{"type":"boolean","default":false},
    "decompile":{"type":"boolean","default":false},
    "depth":{"type":"integer","minimum":0,"maximum":8,"default":2},
    "field_offset":{"type":"string","minLength":1,"maxLength":20,"description":"Exact instance-field byte offset. Offset equality alone cannot identify a class field."},
    "field_selector":{"type":"object","properties":{"image":{"type":"string","minLength":1,"maxLength":1024},"namespace":{"type":"string","maxLength":1024},"class_name":{"type":"string","minLength":1,"maxLength":1024},"name":{"type":"string","minLength":1,"maxLength":1024}},"required":["image","namespace","class_name","name"],"additionalProperties":false},
    "name":{"type":"string","minLength":1,"maxLength":64},
    "locator":{"type":"object","description":"kind=module: module, occurrence, offset and optional build_id (recorded on bind). kind=method: image, namespace, class_name, name and exact metadata token string. kind=field: image, namespace, class_name, name. kind=pointer_chain: recipe. No persistent absolute object addresses."},
    "tid":{"type":"integer","minimum":1,"maximum":2147483647},
    "stop_id":{"type":"string","minLength":1,"maxLength":20},
    "confirm":{"type":"boolean","enum":[true]},
    "expected_thread_start_time":{"type":"string","minLength":1,"maxLength":20},
    "lease_ms":{"type":"integer","minimum":1000,"maximum":15000},
    "expected_pc":{"type":"string","minLength":1,"maxLength":20},
    "registers":{"type":"object","minProperties":1,"maxProperties":128,"description":"Exact ARM64 bit strings: X/W, PC/SP, FP/LR, NZCV/PSTATE (NZCV bits only), V/Q/D/S/H/B, FPSR/FPCR, TLS, optional active SVE Z/P/FFR. S/D also accept float:1.5. W zero-extends X; low SIMD views preserve upper bits. Alias overlap rejected; unsupported register sets fail independently."},
    "on_hit":{"type":"object","properties":{"registers":{"type":"object"},"continue":{"type":"boolean","default":false}},"required":["registers"],"additionalProperties":false,"description":"On matched hits apply checked registers, record before/after/readback/rollback. continue=true explicitly auto-resumes after success; failures stay stopped. Lease not renewed."},
    "condition":{"type":"object","properties":{"register":{"type":"string","maxLength":3},"op":{"type":"string","enum":["eq","ne","gt","ge","lt","le","mask"]},"value":{"type":"string","minLength":1,"maxLength":20}},"required":["register","op","value"],"additionalProperties":false},
    "after_hits":{"type":"string","minLength":1,"maxLength":20,"description":"Skip this many hits; counter remains exact uint64 text."},
    "after_sequence":{"type":"string","minLength":1,"maxLength":20},
    "id":{"type":"string","minLength":1,"maxLength":96},
    "operation":{"type":"string","enum":["begin","chunk","commit","cancel","status","list"]},
    "file_name":{"type":"string","minLength":1,"maxLength":128},
    "file_size":{"type":"integer","minimum":64,"maximum":67108864},
    "crc32":{"type":"integer","minimum":0,"maximum":4294967295},
    "chunk_offset":{"type":"integer","minimum":0,"maximum":67108864},
    "hex":{"type":"string","minLength":2,"maxLength":65536},
    "hex_bytes":{"type":"string","minLength":2,"maxLength":131072},
    "allow_execute":{"type":"boolean","enum":[true]},
    "call_jni_onload":{"type":"boolean","default":false},
    "global_symbols":{"type":"boolean","default":false}
  },
  "tools": [
    {"name":"il2cpp_symbols_get","description":"Read Root-owned persisted IL2CPP API overrides and current target's startup configuration. Global across configured targets, applies next target start; restart_required compares both. Existing automatic compatibility remains enabled when overrides are empty. No runtime API calls.","parameters":[],"features":["il2cpp_metadata"],"command":"IL2CPP_SYMBOLS_CONTROL","op":"get"},
    {"name":"il2cpp_symbols_list_apis","description":"List supported standard il2cpp API keys accepted by symbol override configuration. No API probing, attaching or runtime invocation.","parameters":[],"features":["il2cpp_metadata"],"command":"IL2CPP_SYMBOLS_CONTROL","op":"list_apis"},
    {"name":"il2cpp_symbols_validate","description":"Validate configuration syntax, known API names, duplicate entries and explicit module/allow_offsets=1 consent for 0x module-relative offsets. Returns normalized text without saving or calling addresses. This does NOT establish correct ABI/signatures or decrypted metadata.","parameters":[],"extra_properties":{"config":{"type":"string","maxLength":16384,"description":"UTF-8 text: standard_api=renamed_export; optional module=loaded SO name. Relative offsets need explicit module=... and allow_offsets=1."}},"required":["config"],"features":["il2cpp_metadata"],"command":"IL2CPP_SYMBOLS_CONTROL","op":"validate"},
    {"name":"il2cpp_symbols_set","description":"Atomically persist validated Root-owned IL2CPP symbol mapping with confirm=true. GLOBAL across configured targets; next target start only, no hot pointer replacement. Executable-range checks at startup do not prove ABI, and incorrect offsets can crash targets. Do not guess addresses; confirm offset/signature evidence before saving. No automatic retry after unknown mutation outcome.","parameters":["confirm"],"extra_properties":{"config":{"type":"string","maxLength":16384}},"required":["config","confirm"],"features":["il2cpp_metadata"],"command":"IL2CPP_SYMBOLS_CONTROL","op":"set","readonly":false},
    {"name":"il2cpp_symbols_reset","description":"With confirm=true save an empty override file to restore automatic runtime detection on next target start. Does not unload libraries, detach game threads, or alter the active API table.","parameters":["confirm"],"required":["confirm"],"features":["il2cpp_metadata"],"command":"IL2CPP_SYMBOLS_CONTROL","op":"reset","readonly":false},
    {"name":"list_strings","description":"Enumerate ASCII and UTF16LE strings from selected ELF data segments. Specify module/occurrence or an address. Bounded snapshot, coverage/partial and pagination; no target function calls.","parameters":["module","occurrence","address","offset","limit","scan_mb","timeout_ms","refresh"],"features":["assembly","memory_read"],"op":"list_strings"},
    {"name":"search_strings","description":"Search UTF-8/UTF-16LE (including Chinese/emoji) substrings in a module, process readable mappings or explicit ranges. Exact address strings, checked backend copies, bounded bytes/time. Repeat with cursor and SAME scope/query to continue; has_more=false is only the end of this scope, not proof that an encrypted/computed string does not exist. Optional include_il2cpp adds class/field owner candidates. case_sensitive=false folds ASCII letters only. No runtime getter/GC heap scan.","parameters":["module","occurrence","address","query","offset","scan_mb","timeout_ms","refresh","scope","ranges","encoding","cursor","include_il2cpp"],"extra_properties":{"limit":{"type":"integer","minimum":1,"maximum":256},"case_sensitive":{"type":"boolean","default":true}},"required":["query"],"features":["memory_search","memory_read"],"command":"MEMORY_STRING_SEARCH"},
    {"name":"find_string_xrefs","description":"Cross-locate a string to ARM64 instruction addresses and aligned reference slots across a module/process/ranges, with cursor continuation. include_il2cpp=true resolves slot owners and fields, and recognizes references to a validated managed String header when given its character address. Instruction results include assembly and navigation actions. Bounded direct references; indirect/computed references can be absent, coverage is explicit.","parameters":["address","module","occurrence","scope","ranges","cursor","include_il2cpp","offset","scan_mb","timeout_ms","refresh"],"extra_properties":{"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["address"],"features":["assembly","memory_read"],"command":"MEMORY_STRING_XREFS"},
    {"name":"string_write","description":"Modify a string with expected old value and confirm=true. mode=raw: address + encoding utf8/utf16le/ascii, bounded capacity (default old terminated byte length), checked writable NON-executable range, compare-before-write and readback, change_history records bytes. Never use raw mode on managed String data. mode=managed_field: object_address + exact field; queues a game-frame new string allocation and GC write-barrier reference replacement, preserving the shared old String. Poll workspace_result for queued work; do not replay an uncertain write.","parameters":["address","object_address","field","confirm"],"extra_properties":{"mode":{"type":"string","enum":["raw","managed_field"],"default":"raw"},"encoding":{"type":"string","enum":["utf8","utf16le","ascii"]},"value":{"type":"string","maxLength":16384},"expected":{"type":"string","maxLength":16384},"capacity_bytes":{"type":"integer","minimum":1,"maximum":65536}},"required":["value","expected","confirm"],"features":["memory_read","memory_write"],"command":"MEMORY_STRING_WRITE","readonly":false},
    {"name":"address_resolve","description":"Resolve an address to trusted-metadata object-header candidates, class and inherited/nested inline fields, real offsets and actionable storage addresses. owner_scan_bytes controls bounded backwards scanning. Does not call APIs on unknown header class pointers, getters or heap GC. An interior address has no universal owner oracle: matches are layout-validated candidates, not allocation/liveness proof; metadata_complete=false means repeat to finish incremental metadata indexing. Static/thread-static storage is not guessed.","parameters":["address","timeout_ms","work_limit"],"extra_properties":{"owner_scan_bytes":{"type":"integer","minimum":0,"maximum":16777216,"default":65536},"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["address"],"features":["il2cpp_metadata","il2cpp_objects","memory_read"],"command":"IL2CPP_ADDRESS_RESOLVE"},
    {"name":"address_relations","description":"Find actual memory paths between source and target addresses (default both directions), not just same field offsets. Traverses inherited fields, embedded structs, references, arrays/List/Dictionary backing storage and optional native pointer slots. Returns class/type/field/offset chains, storage addresses and navigation actions. Alternate simple paths are retained; max_depth up to 32. Continue with returned cursor plus page budgets; has_more/stop_reasons expose unfinished work. No getter or unknown-function execution. Bounded outgoing reachability is not a global heap nonexistence proof.","parameters":["cursor","timeout_ms","work_limit"],"extra_properties":{"source":{"type":"string","minLength":1,"maxLength":20},"target":{"type":"string","minLength":1,"maxLength":20},"direction":{"type":"string","enum":["both","forward"],"default":"both"},"owner_scan_bytes":{"type":"integer","minimum":0,"maximum":16777216,"default":65536},"max_depth":{"type":"integer","minimum":1,"maximum":32,"default":15},"max_nodes":{"type":"integer","minimum":1,"maximum":100000,"default":10000},"max_offset":{"type":"integer","minimum":8,"maximum":65536,"default":512},"array_limit":{"type":"integer","minimum":1,"maximum":1000000,"default":65536},"include_native":{"type":"boolean","default":true},"limit":{"type":"integer","minimum":1,"maximum":256}},"features":["il2cpp_metadata","il2cpp_objects","pointer_chain","memory_read"],"command":"MEMORY_ADDRESS_RELATIONS"},
    {"name":"field_activity","description":"Field write/read source analysis. action=inspect (default) resolves object_address+field and current bytes; optional code_address/module adds static field-offset access candidates. action=start with confirm=true opens an exclusively owned external Root perf watchpoint (access w/r/rw); returns activity_id. poll with activity_id/after_hit_id returns hit counts, thread, PC/SP/LR/GPR, captured-stack backtraces and nearby instruction candidates. PC is not automatically a proven writer and samples can be lost. stop needs activity_id+confirm; never removes others' watchpoints. list/help supported. No unknown API invocation or automatic hooks during inspect.","parameters":["object_address","field","confirm","module","occurrence","size","offset","scan_mb","timeout_ms","work_limit"],"extra_properties":{"action":{"type":"string","enum":["inspect","start","poll","stop","list","help"],"default":"inspect"},"activity_id":{"type":"string","minLength":1,"maxLength":96},"access":{"type":"string","enum":["w","r","rw"],"default":"w"},"code_address":{"type":"string","minLength":1,"maxLength":20},"after_hit_id":{"type":"string","minLength":1,"maxLength":20},"limit":{"type":"integer","minimum":1,"maximum":256}},"features":["il2cpp_metadata","il2cpp_objects","memory_read"],"command":"IL2CPP_FIELD_ACTIVITY","readonly":false},
    {"name":"xrefs_to","description":"Find direct references to an address (code, string or global). Shows instruction address, kind and evidence; absence in a partial scan is not proof of no references.","parameters":["address","offset","limit","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"xrefs_to"},
    {"name":"xrefs_from","description":"References originating in a function/bounded code window. Known ELF sizes inferred; stripped boundaries are not fabricated.","parameters":["address","size","offset","limit","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"xrefs_from"},
    {"name":"list_functions","description":"ELF dynamic FUNC symbols plus ARM64 direct-call targets with provenance. Exact ranges only for validated symbol sizes; heuristic candidates have null end.","parameters":["module","occurrence","address","query","offset","limit","scan_mb","timeout_ms","refresh"],"features":["assembly","memory_read"],"op":"list_functions"},
    {"name":"get_function","description":"Resolve an arbitrary address to a confirmed ELF function or exact candidate start. Fails rather than assigning an arbitrary nearest preceding function.","parameters":["address","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"get_function"},
    {"name":"callers","description":"Find direct BL callsites targeting this address with known containing function identities. Indirect BLR targets require runtime evidence.","parameters":["address","offset","limit","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"callers"},
    {"name":"callees","description":"Direct outgoing calls from an inferred ELF function or explicit bounded window. Returns code addresses usable by analyze_function/debugger tools.","parameters":["address","size","offset","limit","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"callees"},
    {"name":"call_graph","description":"Bounded recursive direct-call graph. depth 0..8, maximum 1024 queued nodes, cycle detection and coverage. Unresolved external/indirect calls are not executed.","parameters":["address","size","depth","offset","limit","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"call_graph"},
    {"name":"analyze_function","description":"One analysis bundle: assembly, CFG, calls, strings, references, cached IL2CPP metadata and optional pseudocode with source maps. Each component has independent status; optional decompiler failure does not discard assembly. decompile defaults false; set true explicitly. Does not invoke game functions.","parameters":["address","size","decompile","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"analyze_function"},
    {"name":"field_accesses","description":"Find reads/writes with argument-register provenance. Pass field_offset OR exact field_selector {image,namespace,class_name,name} (resolved from metadata). address selects one function; module/occurrence scans candidate functions (offset/limit page FUNCTIONS, next_offset continues). Returns candidates, widths, expressions and cached method-this type evidence; offset equality alone is not field identity proof. Static/literal fields are rejected by selector mode.","parameters":["address","module","occurrence","size","field_offset","field_selector","offset","limit","scan_mb","timeout_ms","refresh"],"features":["assembly","memory_read"],"op":"field_accesses"},
    {"name":"dataflow_query","description":"Conservative ARM64 register-origin and memory-access expressions. Tracks ABI arguments through MOV/ADD/ADRP and load/store; resets unknown definitions and control-flow joins. Explicitly static, not a runtime observation.","parameters":["address","size","scan_mb","timeout_ms","refresh"],"required":["address"],"features":["assembly","memory_read"],"op":"dataflow"},
    {"name":"analysis_cache_clear","description":"Invalidate this process's short-lived static analysis caches. Read data is rescanned next time; no hooks or game memory changes.","parameters":[],"features":["assembly"],"op":"cache_clear","readonly":false},
    {"name":"symbol_bind","description":"Persist a symbolic locator, validate it against the current target, and return its current resolution. Module identities pin ELF build ID; methods pin exact metadata token. Store recipes only, never live absolute addresses. No invocations/writes.","parameters":["name","locator"],"required":["name","locator"],"features":["diagnostics","memory_maps"],"op":"symbol_bind","readonly":false},
    {"name":"symbol_resolve","description":"Re-resolve a saved locator after ASLR or target restart, checking current module build ID or exact metadata identity. A mismatch fails; queued queries require polling. Never restores old raw addresses.","parameters":["name"],"required":["name"],"features":["diagnostics","memory_maps"],"op":"symbol_resolve"},
    {"name":"symbol_list","description":"List persisted locator names in target-private storage. Pure recipes survive restart; use symbol_resolve for live addresses.","parameters":[],"features":["diagnostics","memory_maps"],"op":"symbol_list"},
    {"name":"crash_diagnose","description":"Root-side target-scoped crash evidence: matching tombstones, recent durable MCP intents/outcomes and module map at registration. Works for the selected exited session. After app/device restart select that app and pass previous=true to read its latest persisted exited session with matching UID. Normal exit is not proof of crash. Correlation is not proof of cause; unavailable evidence is explicit. Never deletes logs or attaches another process.","parameters":["previous"],"features":["diagnostics"],"command":"CRASH_DIAGNOSE"},
    {"name":"debugger_status","description":"External Root per-thread stopping debugger capability and lease state, not perf sampling. Permission and hardware availability are probed only by explicit mutation; unavailable debug subfeatures do not disable other MCP tools.","parameters":[],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"status"},
    {"name":"debugger_registers","description":"Read ARM64 GPR/PC/SP/PSTATE plus independently optional Q0..Q31/FPSR/FPCR, TLS and active SVE Z/P/FFR from an owned stopped thread. Exact hex values and fresh stop_id; extended data has a byte budget and explicit truncation. Read does not extend pause lease or enable CPU extensions.","parameters":["tid"],"required":["tid"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"registers"},
    {"name":"debugger_control","description":"Root ARM64 per-thread pause/resume/resume_all/step/step_over/step_out/continue/set_registers/renew/help. Pause requires expected_thread_start_time, confirm; mutations on stopped state require current stop_id and confirm. continue retains debugger ownership until 1..15s lease expires; resume detaches and restores original hardware breakpoints. Step-over uses temporary return breakpoint for BL/BLR; step-out rejects unmapped/PAC-signed LR. set_registers supports X/W, FP/LR, SP/PC, Q/V/D/S/H/B, FPSR/FPCR, NZCV (other PSTATE bits read-only), TLS and active SVE Z/P/FFR, with write readback and attempted rollback on failure. Unsupported regsets are rejected. S/D accept float:1.5; otherwise exact bit strings. Poll status/registers for asynchronous completion; do not replay pending operations.","parameters":["tid","stop_id","confirm","expected_thread_start_time","lease_ms","registers","expected_pc"],"extra_properties":{"op":{"type":"string","enum":["pause","resume","resume_all","step","step_over","step_out","continue","set_registers","renew","help"]}},"required":["op"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","readonly":false},
    {"name":"debugger_breakpoint_set","description":"Install an owned ARM64 execution breakpoint on a stopped thread. Requires mapped aligned address, fresh stop_id and confirm. Optional condition/after_hits. on_hit={registers:{x0:'0x1',s0:'float:1.5',q1:'0x...'},continue:false} applies validated register changes on matched hits; events record before/after/readback/rollback. GPR/W, FP/SIMD, PC/SP, NZCV, TLS and active SVE Z/P/FFR supported per target. Unsupported/privileged registers fail. continue=true auto-resumes only after success; lease unchanged. Preserves original hardware slots. Explicitly continue after installation.","parameters":["tid","address","stop_id","confirm","condition","after_hits","on_hit"],"required":["tid","address","stop_id","confirm"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"breakpoint_set","readonly":false},
    {"name":"debugger_breakpoint_remove","description":"Remove one owned address breakpoint while stopped, requiring fresh stop_id and confirm. Does not remove original external hardware slots.","parameters":["tid","address","stop_id","confirm"],"required":["tid","address","stop_id","confirm"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"breakpoint_remove","readonly":false},
    {"name":"debugger_breakpoint_list","description":"List owned stopping breakpoints, hit counters and thread state, including while running. Read does not renew lease.","parameters":["tid"],"required":["tid"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"breakpoint_list"},
    {"name":"debugger_breakpoint_events","description":"Read captured stopping-breakpoint events with exact registers/PC/count and on_hit register before/after/readback/error. Cursor is next_after_sequence for after_sequence. Retention is at most 256 events / 4 MiB; byte-budgeted pages expose has_more and dropped_events. No pause/lease extension.","parameters":["tid","after_sequence"],"extra_properties":{"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["tid"],"features":["breakpoint"],"command":"DEBUGGER_CONTROL","op":"breakpoint_events"},
    {"name":"native_library_upload","description":"Python-free custom-SO upload protocol: operation begin(file_name,file_size,crc32), chunk(id,chunk_offset,hex <=32KiB), commit(id,allow_execute=true), cancel(id), status(id), list. Bytes originate on the client; HTTP cannot read a PC path. Begin/chunk never execute code. Commit may execute constructors/JNI and crash/hang target; poll status after pending/transport errors, NEVER re-commit/reinject blindly. Target ABI/ELF/CRC are verified by the existing loader. No unload, security bypass or arbitrary PID.","parameters":["operation","file_name","file_size","crc32","id","chunk_offset","hex","allow_execute","call_jni_onload","global_symbols"],"required":["operation"],"features":["native_libraries"],"command":"NATIVE_LIBRARY_CONTROL","renames":{"operation":"op","file_name":"name","file_size":"size","chunk_offset":"offset"},"readonly":false},
    {"name":"render_instance_inventory","description":"Live Unity class counts plus referenced List/Dictionary/array fields. Class counts include derived types (exact_count excludes derived types) and inactive objects when supported; check include_inactive_effective. Publishes whole snapshots atomically and retains previous counts while scanning. Returns sort=count_desc, count_source=completed_unity_snapshot, generation, sampled_at, age_ms, complete/error. Collections update independently: check collections_supported/running/complete/error. refresh=true requests another pass; query filters class, namespace, image and owner. Not an exhaustive GC heap scan. Returns pending/request_id: poll workspace result, then query again for updates. UI uses the same inventory. No arbitrary property calls or game writes.","parameters":["refresh"],"extra_properties":{"query":{"type":"string","maxLength":256},"offset":{"type":"integer","minimum":0,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":256}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"],"command":"IL2CPP_RENDER_INVENTORY","op":"list","game_frame":true},
    {"name":"render_inventory_items","description":"Page a fresh typed Unity query for an inventory class (including derived and supported inactive objects), or elements of a discovered collection. Class totals may be newer than the last inventory snapshot; includes count_source=fresh_type_query and sampled_at. Use entry_id from render_instance_inventory; expired entries/collections fail without stale-address dereferencing. Returns pending/request_id; poll workspace result. Object addresses can be opened with workspace_navigate or existing inspector tools.","parameters":[],"extra_properties":{"entry_id":{"type":"string","minLength":1,"maxLength":96},"offset":{"type":"integer","minimum":0,"maximum":2147483647},"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["entry_id"],"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"],"command":"IL2CPP_RENDER_INVENTORY","op":"objects","game_frame":true},
    {"name":"render_inventory_set","description":"Enable/disable visualizations for ALL still-live objects in a discovered class group or collection. No fixed object cap; bounded work per game frame. Unsupported/scalar elements are skipped, no game-object writes. Poll workspace result for render_task_id, then render_inventory_status until render_pending=false. updated/skipped/truncated/error are explicit; never replay a lost mutation blindly.","parameters":[],"extra_properties":{"entry_id":{"type":"string","minLength":1,"maxLength":96},"enabled":{"type":"boolean"}},"required":["entry_id","enabled"],"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"],"command":"IL2CPP_RENDER_INVENTORY","op":"render","game_frame":true,"readonly":false},
    {"name":"render_inventory_status","description":"Poll a multi-frame inventory render task (task_id optional: most recent). Returns render_pending, updated/skipped/processed/error, render_limit=null. cancel=true stops unfinished work; it does not undo already applied visualizations. This query also uses workspace result polling; no guessed old object addresses.","parameters":[],"extra_properties":{"task_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"cancel":{"type":"boolean"}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"],"command":"IL2CPP_RENDER_INVENTORY","op":"render_status","game_frame":true,"readonly":false},
    {"name":"memory_read","description":"Read a bounded range with the selected memory backend. Exact address strings, named parameters identical on Python/native HTTP.","parameters":["address"],"extra_properties":{"size":{"type":"integer","minimum":1,"maximum":65536}},"required":["address","size"],"features":["memory_read"],"command":"MEMORY_READ","tokens":["address","size"]},
    {"name":"memory_write","description":"Verified mapped writable memory write. Exact bytes as hex; explicit mutation, no automatic retry.","parameters":["address","hex_bytes"],"required":["address","hex_bytes"],"features":["memory_write"],"command":"MEMORY_WRITE","tokens":["address","hex_bytes"],"readonly":false}
  ]
})mcp"
