t":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"occurrence":{"type":"integer","minimum":1,"maximum":4096}},"required":["kind","address"],"additionalProperties":false}},"required":["selection"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"workspace_history","description":"Navigate history: supply direction back/forward OR index from workspace_state using the SAME scope (global default, or independent object path). Ancestor selection preserves forward entries until a new branch is opened. No game actions.","inputSchema":{"type":"object","properties":{"direction":{"type":"string","enum":["back","forward"]},"index":{"type":"integer","minimum":0,"maximum":63},"scope":{"type":"string","enum":["global","object"]}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"workspace_bookmark_set","description":"Bookmark a live selection. Presets keep only symbolic method/module+offset bookmarks; raw object pointers are deliberately not persisted across restart.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"selection":{"type":"object","properties":{"kind":{"type":"string","enum":["object","memory","method"]},"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"label":{"type":"string","maxLength":256},"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","maxLength":256},"method":{"type":"string","maxLength":256},"token":{"type":"integer","minimum":1,"maximum":4294967295},"module":{"type":"string","maxLength":256},"offset":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"occurrence":{"type":"integer","minimum":1,"max