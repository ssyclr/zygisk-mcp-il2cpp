"maximum":4096},"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["mode"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"unity_object_resources","description":"Queue Unity resource inspection. mode=object (default): live address required; GameObject/Component -> components, Renderer -> shared materials (index is material_index), Material -> Shader/main texture, MeshFilter/SkinnedMeshRenderer -> shared Mesh. Texture/Mesh metadata only, no pixel/geometry dumps or clones; offset<=4096. mode=renderers: address=0 finds scene Renderers, or use a GameObject/Component subtree; query filters name/type, include_inactive defaults true. Scans <=256 candidates per request; continue at next_offset while has_more, even with no matches. Live results may change across pages; include_inactive reports effective support. Discovery does not add ESP objects or write materials. Missing APIs/types disable only that capability with reason/diagnostics. Poll workspace_result; export JSON with workspace_export_result. mode=assets: address=0, asset_type required; enumerate already loaded Unity resources (including inactive/internal), filter names/types with query and continue next_offset. This is an on-demand, best-effort live view, not a stable snapshot or load/unload event stream. No asset loading or game writes; unavailable types return isolated diagnostics.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"mode":{"type":"string","enum":["object","renderers","assets"]},"query":{"type":"string","maxLength":256},"include_inactive":{"type":"boolean"},"offset":{"type":"integer","minimum":0,"maximum":10000000},"limit":{"type":"integer","minimum":1,"maximum":128},"asset_type":{"type":"string","enum":["Texture2D","Texture","RenderTexture","Material","Shader","Mesh","AudioClip","Sprite"]}},"required":["address"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"unity_material_properties","description":"Queue actual Shader property names/types/values for a Renderer material slot (0-based). Float/Range, Color, Vector, Texture, Integer where supported. Values identify shared_material vs property_block; effective_known=false means effective override cannot be read on this Unity version. last_written is history, not proof of current value. Includes writable/reason and has_saved_override. Shader globals and undeclared names are not editable. Poll workspace_result. Does not change rendering.","inputSchema":{"type":"object","properties":{"renderer":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"material_index":{"type":"integer","minimum":0,"maximum":255},"offset":{"type":"integer","minimum":0,"maximum":4096},"limit":{"type":"integer","minimum":1,"maximum":128}},"required":["renderer"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"unity_material_set_property","description":"Queue a declared Shader property override on ONE Renderer/material slot using MaterialPropertyBlock, never shared Material writes. Query unity_material_properties first. value: finite number for Float/Range/Integer, four numbers for Color RGBA/Vector XYZW, live texture address string for Texture (dimension checked). No keyword, shader, global uniform or render-state injection. Effect depends on existing Shader and may be overwritten by the game; no per-frame reapplication. First write snapshots the slot for restore (max 64 slots). Unsupported API/property is disabled independently. Poll workspace_result and check result.applied; accepted is not applied.","inputSchema":{"type":"object","properties":{"renderer":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"material_index":{"type":"integer","minimum":0,"maximum":255},"property":{"type":"string","maxLength":256,"minLength":1},"value":{"type":["number","string","array"],"maxLength":32,"minItems":4,"maxItems":4,"items":{"type":"number","minimum":-1e+20,"maximum":1e+20}}},"required":["renderer","property","value"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke","memory_write"]},{"tool":{"name":"unity_material_restore","description":"Queue restoration of the entire Renderer/material-slot property block captured before its first bridge edit; not an individual-property undo. This also replaces intervening game changes to that indexed block. If originally empty, clears the indexed block to reveal normal Renderer/material values. Refuses changed Material/Shader identities or expired objects. No persistent replay on restart. Poll workspace_result and check result.restored.","inputSchema":{"type":"object","properties":{"renderer":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"material_index":{"type":"integer","minimum":0,"maximum":255}},"required":["renderer"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke","memory_write"]},{"tool":{"name":"il2cpp_inspector_members","description":"Queue inherited fields with values, exact methods and property accessors without calling getters. Either address inspects an object, or image/class/namespace selects a type with optional address for compatible instance values. Without an instance, type mode returns static values only. Includes type_info, reference_address and storage_address for navigation. Uses automatic frame binding; poll workspace_result. Alternatively pass return_handle from il2cpp_call_exact: resolve a bounded session weak GC handle and inspect in the same game-frame request. Cannot combine with address/type selection. Collected/expired objects fail safely;","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","minLength":1,"maxLength":96},"offset":{"type":"integer","minimum":0,"maximum":4096},"limit":{"type":"integer","minimum":1,"maximum":256},"return_handle":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"il2cpp_field_read","description":"Queue one instance/static field read using a live object. Field may be DeclaringType::name to disambiguate inheritance. Returns request_id; result includes exact value_text for 64-bit values.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"field":{"type":"string","maxLength":256}},"required":["address","field"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"il2cpp_field_write","description":"Queue an explicit field write; rejects constants/readonly fields and incompatible references. Scalars use KittyMemory, managed references use IL2CPP GC write barriers. Supports enum names and typed arguments. Poll workspace_result for actual success/before/after; acceptance is not completion.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"field":{"type":"string","maxLength":256},"value":{"type":["object","string","number","boolean","null"],"maxLength":4096,"description":"Primitive, {enum:name}, {address:hex}, or {type:i64|u64|f32|string|bool|object|enum|null,value:...}. Use decimal text in typed i64/u64 for exact values."}},"required":["address","field","value"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke","memory_write"]},{"tool":{"name":"il2cpp_call_exact","description":"Queue an exact overload by declaring image/namespace/class and metadata token (from inspector). Supports up to 32 typed arguments, enum names, references and static calls (instance=0). Invocation may change game state. Struct/byref support is limited by existing marshaler; unsupported signatures return an error. Result via workspace_result. Also supports unmanaged structs as {fields:{field:value}}, ref/out arguments with arguments_after in the result, and optional generic_handle from il2cpp_generic_resolve. No fabricated AOT methods.","inputSchema":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","minLength":1,"maxLength":96},"token":{"type":"integer","minimum":1,"maximum":4294967295},"instance":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"arguments":{"type":"array","items":{"type":["object","string","number","boolean","null"],"maxLength":4096,"description":"Primitive, {enum:name}, {address:hex}, or {type:i64|u64|f32|string|bool|object|enum|null,value:...}. Use decimal text in typed i64/u64 for exact values."},"minItems":0,"maxItems":32},"generic_handle":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20}},"required":["image","class","token"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"il2cpp_dictionary_items","description":"Queue Dictionary enumeration as key/value pairs using its managed enumerator, not assumed layouts. Offset <=4096, limit <=128; generic stripping or missing accessors returns an isolated error. Poll workspace_result.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"offset":{"type":"integer","minimum":0,"maximum":4096},"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["address"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"workspace_result","description":"Fetch a queued frame request. Check pending first, then success/error/result. Only latest 32 requests retained; unexecuted requests expire after 5 seconds and never execute later.","inputSchema":{"type":"object","properties":{"request_id":{"type":"integer","minimum":1,"maximum":9007199254740991}},"required":["request_id"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"workspace_export_result","description":"Export a completed queued result on the TARGET device to clipboard or private files/zygisk_il2cpp_mcp/exports. Returns success/path/bytes only, not the data. Clipboard <=256 KiB; file <=8 MiB. Does not read clipboard.","inputSchema":{"type":"object","properties":{"request_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"destination":{"type":"string","enum":["clipboard","file"]},"filename":{"type":"string","maxLength":80,"pattern":"[A-Za-z0-9_-]{1,64}\\.(?:txt|json|cs|c|asm|lua|csv)"}},"required":["request_id","destination","filename"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","ui"]},{"tool":{"name":"workspace_export_text","description":"Export supplied UTF-8 text to target clipboard/private exports. Filename is a safe stem plus supported extension, not a path. <=112 KiB per MCP request. Returns status/path only. For large cached inspector results use workspace_export_result.","inputSchema":{"type":"object","properties":{"text":{"type":"string","maxLength":114688},"destination":{"type":"string","enum":["clipboard","file"]},"filename":{"type":"string","maxLength":80,"pattern":"[A-Za-z0-9_-]{1,64}\\.(?:txt|json|cs|c|asm|lua|csv)"}},"required":["text","destination","filename"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","ui"]},{"tool":{"name":"workspace_export_job","description":"Export the latest completed manual UI job by owner without transferring its contents through MCP. Useful for inspector/assembly/decompiler output; errors if owner has no completed successful result.","inputSchema":{"type":"object","properties":{"owner":{"type":"string","maxLength":128},"destination":{"type":"string","enum":["clipboard","file"]},"filename":{"type":"string","maxLength":80,"pattern":"[A-Za-z0-9_-]{1,64}\\.(?:txt|json|cs|c|asm|lua|csv)"}},"required":["owner","destination","filename"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","ui"]},{"tool":{"name":"workspace_export_logs","description":"Export the target's current native call log, optionally filtering by text/failure/remote. Clipboard <=256 KiB; larger logs should use file. Returns success/path only, not the log contents. Does not clear the log.","inputSchema":{"type":"object","properties":{"destination":{"type":"string","enum":["clipboard","file"]},"filename":{"type":"string","maxLength":80,"pattern":"[A-Za-z0-9_-]{1,64}\\.(?:txt|json|cs|c|asm|lua|csv)"},"filter":{"type":"string","maxLength":256},"failures_only":{"type":"boolean"},"remote_only":{"type":"boolean"}},"required":["destination","filename"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","ui"]},{"tool":{"name":"workspace_preset","description":"Manage target-private UI/render presets: list, data, save, load or import. name uses ASCII safe stem; import accepts JSON text <=112 KiB and saves without applying. load checks target package+version, restores display/rules, stops Lua programs, and starts native logic only when auto_start=true. Runtime object handles and game writes are not restored. A preset named default auto-loads on next overlay startup. Storage files/zygisk_il2cpp_mcp/presets; save/load return status/path only. Symbolic bookmarks must be resolved again after restart.","inputSchema":{"type":"object","properties":{"operation":{"type":"string","enum":["list","data","save","load","import"]},"name":{"type":"string","maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"json":{"type":"string","maxLength":114688}},"required":["operation"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","rendering"]},{"tool":{"name":"unity_resource_monitor","description":"Start/stop or read incremental loaded-resource observations on the game frame. op=start accepts type/query/interval_ms(500..60000)/max_candidates(64..65536). Uses periodic snapshot differences, NOT lossless load/unload hooks. Events: added/changed/no_longer_observed. Partial passes never emit disappearance. Events ring 512; use decimal-string after_sequence/next_sequence; check dropped_events/partial/error. clear clears event history, not the monitor. Never loads game assets. Poll workspace_result.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["start","stop","status","events","clear"]},"type":{"type":"string","enum":["Texture2D","Texture","RenderTexture","Material","Shader","Mesh","AudioClip","Sprite"]},"query":{"type":"string","maxLength":256},"interval_ms":{"type":"integer","minimum":500,"maximum":60000},"max_candidates":{"type":"integer","minimum":64,"maximum":65536},"after_sequence":{"type":"string","pattern":"(?:0|[1-9][0-9]{0,19})","maxLength":20},"limit":{"type":"integer","minimum":1,"maximum":256}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"il2cpp_generic_resolve","description":"Resolve a closed generic type and optionally a method via runtime reflection. type is the generic definition; type_arguments and method_arguments are 1..16 exact type selections. Optional token selects the method. Returns generic_handle for existing il2cpp_call_exact and il2cpp_parameter_schema. Handles are process-session scoped, at most 64. This does NOT JIT missing AOT instances: stripped APIs, unavailable instantiations or failed constraints disable only this operation. Poll workspace_result.","inputSchema":{"type":"object","properties":{"type":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class_name":{"type":"string","maxLength":256}},"required":["image","class_name"],"additionalProperties":false},"token":{"type":"integer","minimum":1,"maximum":4294967295},"type_arguments":{"type":"array","items":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class_name":{"type":"string","maxLength":256}},"required":["image","class_name"],"additionalProperties":false},"minItems":1,"maxItems":16},"method_arguments":{"type":"array","items":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class_name":{"type":"string","maxLength":256}},"required":["image","class_name"],"additionalProperties":false},"minItems":1,"maxItems":16}},"required":["type"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"il2cpp_parameter_schema","description":"Describe exact method parameters, enum members, byref flags and recursively validated unmanaged struct fields (depth8/size1024). Use {fields:{...}} for struct values, {number:'...'} for exact integer struct fields; omitted fields are zero. Structs containing managed references are rejected. Existing il2cpp_call_exact handles invocation and returns arguments_after for ref/out. Optional generic_handle selects a closed method. Poll workspace_result.","inputSchema":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","maxLength":256},"token":{"type":"integer","minimum":1,"maximum":4294967295},"generic_handle":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20}},"required":["image","class","token"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"frida_control","description":"Optional embedded ARM64 Frida Gum, no GumJS/server required. op=status/list/events/attach/stalk/stop/stop_all. attach: executable function address, optional backtrace, duration_ms default60000; captures enter/leave, x0..x30/sp/pc/nzcv, integer/pointer args/return, accurate backtrace if available. stalk: target thread_id, call/return and optional blocks, duration default5000. All instrumentation expires within duration(100..600000ms). stop needs id. Events bounded1024, limit<=128, decimal-string cursors; check cursor_gap/dropped_contention. Counters may exceed retained snapshots. Not software breakpoints, no automatic target changes or JavaScript. Up to128 tasks per process session. Does not coexist with Dobby at the same entry address. For JavaScript execution use frida_script (load/list/post/messages/unload/help); this tool remains C instrumentation only.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["status","attach","stalk","list","events","stop","stop_all"]},"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"thread_id":{"type":"integer","minimum":1,"maximum":2147483647},"duration_ms":{"type":"integer","minimum":100,"maximum":600000},"backtrace":{"type":"boolean"},"blocks":{"type":"boolean"},"id":{"type":"integer","minimum":1,"maximum":128},"after_sequence":{"type":"string","pattern":"(?:0|[1-9][0-9]{0,19})","maxLength":20},"limit":{"type":"integer","minimum":1,"maximum":128}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["frida","trace"]},{"tool":{"name":"unity_resource_preview","description":"Queue a detached snapshot on the game frame. kind=texture(default): readable CPU pixels or Unity GPU Blit/ReadPixels for compressed/non-readable textures, RenderTexture and Sprite whole atlas. max_edge16..1024; source<=4M pixels. kind=model: Mesh/MeshFilter/SkinnedMeshRenderer geometry, <=131072 vertices/131072 triangles. Overlay shows independent orbit/zoom geometry window (no material shader). Latest one snapshot per kind. Returns metadata only, not pixels/geometry. GPU path uses temporary Unity objects and restores active render target; may stall. Missing APIs fail only this operation. Poll workspace_result.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"kind":{"type":"string","enum":["texture","model"]},"max_edge":{"type":"integer","minimum":16,"maximum":1024}},"required":["address"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"unity_resource_export","description":"Export a live resource to target-private files/zygisk_il2cpp_mcp/exports. kind=texture(default) produces PNG through built-in zlib encoder, independent of stripped EncodeToPNG. CPU/GPU readback; Sprite whole atlas. kind=model produces complete bounded OBJ local-space geometry (no materials/UV). Safe ASCII name stem, no path or extension. Returns success/path/bytes only, not file data. Poll workspace_result; queue acceptance is not completion.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"kind":{"type":"string","enum":["texture","model"]},"name":{"type":"string","maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"}},"required":["address"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_objects","il2cpp_invoke"]},{"tool":{"name":"memory_search_tabs","description":"Shared GG-style memory workspace used by the manual UI and MCP. op=list/create/update/focus/duplicate/remove/clear/search/refine/results/select/save_selection/saved_list/saved_remove/export. Up to 512 independent tabs. create accepts name; duplicate copies query only. All tab ops require tab_id; optional version provides compare-and-swap. search accepts query {types:['i32'],value:'100;200::512',mode:'exact',regions:'anonymous,heap,app_data'}; semicolon=joint, :N unordered span, ::N ordered span, default 512; span counts distance between first bytes + 1. B/W/D/Q/F/E suffixes select signed byte/word/dword/qword/float/double. a~b is inclusive numeric range. hex accepts ?? and nibble wildcards; utf8/utf16 literal text. Search returns ALL witnessed group members, not A OR B. Fuzzy creates a bounded unknown-value snapshot. Refine mode=equals/not_equals/greater/less/changed/unchanged/increased/decreased/increased_by/decreased_by; value required for numeric comparisons. results merges tab sessions with per-row id/type, supports offset/limit/live (live does not change baseline). select: mode=add/remove with ids, or all/none. save_selection copies selected rows to a PROCESS-LOCAL saved list; no automatic replay after restart. export scope=selected/all, source=results/saved, destination=file/clipboard; files return status/path/count only. Reads use the WebUI-selected external root driver or local KittyMemory. Check truncated/stop_reason/read_error; not every GG grammar is supported. No memory writes: use memory_batch_edit or existing freeze tools.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["list","create","update","focus","duplicate","remove","clear","search","refine","results","select","save_selection","saved_list","saved_remove","export"]},"tab_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"version":{"type":"integer","minimum":1,"maximum":9007199254740991},"name":{"type":"string","minLength":1,"maxLength":96},"query":{"type":"object","properties":{"mode":{"type":"string","enum":["exact","fuzzy"]},"types":{"type":"array","items":{"type":"string","enum":["bool","i8","u8","i16","u16","i32","u32","i64","u64","f32","f64","hex","utf8","utf16"]},"minItems":1,"maxItems":8},"value":{"type":"string","maxLength":2048},"regions":{"type":"string","minLength":1,"maxLength":256},"start":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"end":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"max_results":{"type":"integer","minimum":1,"maximum":100000},"scan_mb":{"type":"integer","minimum":1,"maximum":512},"timeout_ms":{"type":"integer","minimum":100,"maximum":60000},"alignment":{"type":"integer","minimum":1,"maximum":4096}},"required":[],"additionalProperties":false},"mode":{"type":"string","enum":["equals","not_equals","greater","less","changed","unchanged","increased","decreased","increased_by","decreased_by","add","remove","all","none"]},"value":{"type":"string","maxLength":2048},"offset":{"type":"integer","minimum":0,"maximum":800000},"limit":{"type":"integer","minimum":1,"maximum":1000},"live":{"type":"boolean"},"ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128},"minItems":0,"maxItems":1000},"scope":{"type":"string","enum":["selected","all"]},"source":{"type":"string","enum":["results","saved"]},"destination":{"type":"string","enum":["file","clipboard"]}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["memory_search","memory_read"]},{"tool":{"name":"memory_batch_edit","description":"Write or freeze 1..256 selected memory-workspace rows using the selected data backend. source=results (default) requires tab_id and uses its current selection; source=saved requires explicit saved ids. value is exact text encoded separately for each row type. confirm=true is REQUIRED. Duplicate/overlapping addresses and non-writable/executable mappings are rejected. freeze=true creates/updates existing freeze tasks, interval_ms=20..60000; manage through existing memory_freeze_* tools. Batch is NOT atomic; reports requested/processed/succeeded and per-row errors, stops at first failure without falling back to another backend. Larger selections must be divided explicitly. No arbitrary PID or device-node arguments.","inputSchema":{"type":"object","properties":{"tab_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"version":{"type":"integer","minimum":1,"maximum":9007199254740991},"source":{"type":"string","enum":["results","saved"]},"ids":{"type":"array","items":{"type":"string","minLength":1,"maxLength":128},"minItems":0,"maxItems":1000},"value":{"type":"string","minLength":1,"maxLength":2048},"confirm":{"type":"boolean"},"freeze":{"type":"boolean"},"interval_ms":{"type":"integer","minimum":20,"maximum":60000}},"required":["value","confirm"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["memory_read","memory_write"]},{"tool":{"name":"memory_chain_export","description":"Export ALL currently cached results from one pointer scan session to a new target-private JSON file, never just the visible/current page. session_id comes from memory_scan_base.search; scan_kind=chains (default) selects a multi-level chain scan, pointers selects legacy exact-pointer candidates. Keeps original scan state, truncated/stop reasons, budgets and actual cached/exported counts in the file. Full export does not make a truncated scan complete. Chain JSON preserves module+offset recipes and recipe_batches reusable as memory_chain_batch arguments. Latest four successful chain sessions are retained; expired/non-pointer sessions fail without rescanning. Atomic unique publication never overwrites user files. Returns success/path/count only, never the file contents or result list.","inputSchema":{"type":"object","properties":{"session_id":{"type":"integer","minimum":1,"maximum":9007199254740991},"scan_kind":{"type":"string","enum":["chains","pointers"]}},"required":["session_id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["memory_maps","memory_read","pointer_chain"]},{"tool":{"name":"memory_chain_batch","description":"Resolve/read 1..128 pointer chains or saved IDs. Returns an object with results (per-item success/error), total, succeeded and failed; an item failure does not discard other results. Recipe semantics match memory_resolve_pointer_chain: base+base_offset, then dereference and add each offset; optional final dereference. Values use exact text. Re-resolves modules, never writes memory. No promise of an atomic snapshot. Use existing single-chain tools for one-off calls.","inputSchema":{"type":"object","properties":{"chains":{"type":"array","items":{"type":["object","string"],"properties":{"module":{"type":"string","maxLength":512,"minLength":1},"occurrence":{"type":"integer","minimum":1,"maximum":4096},"base_address":{"type":["string","integer"],"description":"Hexadecimal or decimal address; 0 selects a manual object."},"base_offset":{"type":["string","integer"],"maxLength":32},"offsets":{"type":"array","items":{"type":["string","integer"],"maxLength":32},"minItems":0,"maxItems":32},"pointer_size":{"type":"integer","enum":[4,8]},"dereference_final":{"type":"boolean"},"value_type":{"type":"string","enum":["bool","i8","u8","i16","u16","i32","u32","i64","u64","f32","f64"]},"label":{"type":"string","maxLength":256}},"required":[],"additionalProperties":false,"minLength":1,"maxLength":64},"minItems":1,"maxItems":128}},"required":["chains"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["memory_maps","memory_read","pointer_chain"]},{"tool":{"name":"memory_chain_store","description":"List/save/remove named pointer-chain recipes in target-private settings/chains.json. list returns an object with chains and total (including an empty list); save/remove keep their success/path response. Save accepts MODULE-relative recipes only (no absolute base_address). Does not automatically resolve, freeze or write after restart. Use memory_chain_batch to load saved IDs. Game updates or duplicate module order can invalidate recipes.","inputSchema":{"type":"object","properties":{"operation":{"type":"string","enum":["list","save","remove"]},"id":{"type":"string","minLength":1,"maxLength":64},"recipe":{"type":"object","properties":{"module":{"type":"string","maxLength":512,"minLength":1},"occurrence":{"type":"integer","minimum":1,"maximum":4096},"base_address":{"type":["string","integer"],"description":"Hexadecimal or decimal address; 0 selects a manual object."},"base_offset":{"type":["string","integer"],"maxLength":32},"offsets":{"type":"array","items":{"type":["string","integer"],"maxLength":32},"minItems":0,"maxItems":32},"pointer_size":{"type":"integer","enum":[4,8]},"dereference_final":{"type":"boolean"},"value_type":{"type":"string","enum":["bool","i8","u8","i16","u16","i32","u32","i64","u64","f32","f64"]},"label":{"type":"string","maxLength":256}},"required":[],"additionalProperties":false}},"required":["operation"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["memory_maps","memory_read","pointer_chain"]},{"tool":{"name":"memory_freeze_set","description":"Create or update a recurring KittyMemory write at one writable non-executable address. Value is text (i64/u64 stay exact); hex accepts up to 128 raw bytes. Interval 20..60000 ms. Same address updates its task; overlapping tasks are rejected. Mapping changes/read/write errors stop only that task. Not persisted across process restarts; heap allocation reuse cannot always be detected. Inspect memory_freeze_list for actual writes/errors.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"type":{"type":"string","enum":["bool","i8","u8","i16","u16","i32","u32","i64","u64","f32","f64","hex"]},"value":{"type":"string","maxLength":512},"interval_ms":{"type":"integer","minimum":20,"maximum":60000},"label":{"type":"string","maxLength":256}},"required":["address","type","value"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["memory_read","memory_write"]},{"tool":{"name":"memory_freeze_list","description":"List all session freeze tasks, their enabled state, target value/address, successful write count and last error. This does not create or resume writes.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["memory_read"]},{"tool":{"name":"memory_freeze_control","description":"Pause, resume or remove a freeze by id; clear removes ALL freezes. Resume rechecks the original mapping. clear accepts no id. Removing does not restore a previous memory value.","inputSchema":{"type":"object","properties":{"operation":{"type":"string","enum":["pause","resume","remove","clear"]},"id":{"type":"integer","minimum":1,"maximum":9007199254740991}},"required":["operation"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["memory_read","memory_write"]},{"tool":{"name":"dobby_trace_list","description":"List user-created Dobby tracers/counters, target addresses, enabled state, hit counts and dropped snapshots. Internal game-frame probes are not exposed as user tracers.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["dobby","trace"]},{"tool":{"name":"dobby_trace_control","description":"Pause/resume/reset/remove one user tracer or counter. Pause leaves instrumentation installed but stops capture/counting. reset clears captured history/count; remove uninstalls only a managed user tracer.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":32,"pattern":"(?:0[xX][0-9a-fA-F]+|[0-9]+)"},"operation":{"type":"string","enum":["pause","resume","reset","remove"]}},"required":["address","operation"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"featu