update_object","description":"Change a visualization's enabled flag, UTF-8 label, RRGGBBAA color (00000000 inherits), or positive height/width/depth; never writes the game object.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"key":{"type":"string","enum":["enabled","label","color","height","width","depth"]},"value":{"type":["string","number","boolean"],"description":"Must match the chosen key's type/range. See tool description or debug_help."}},"required":["id","key","value"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_set_object_position","description":"Update a MANUAL object's world position. Live Unity objects are sampled and cannot be moved through this tool.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"position":{"type":"array","items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"minItems":3,"maxItems":3}},"required":["id","position"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_set_object_bones","description":"Replace a manual object's world-space line segments (up to 64). Each segment is [fromXYZ,toXYZ]. Empty array clears bones; Unity humanoid bones are collected automatically if available.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"segments":{"type":"array","maxItems":64,"items":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"array","items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"minItems":3,"maxItems":3}}}},"required":["id","segments"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_remove_object","description":"Remove one render entry only, never destroys a game object.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_clear_objects","description":"Clear visualized objects AND automatic tracked classes; does not change game objects, primitives or the frame hook.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_set_camera","description":"Select Unity main/current/custom-address camera. Requires explicit frame binding; Camera.current may be null in Update, so main is preferred. Manual matrices use render_set_camera_matrix instead.","inputSchema":{"type":"object","properties":{"mode":{"type":"string","enum":["main","current","address"]},"address":{"type":["string","integer"],"description":"Hexadecimal or decimal address; 0 selects a manual object."}},"required":["mode"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_list_cameras","description":"Read up to 64 camera addresses cached by the bound Unity game frame (refreshed about every two seconds); choose an address via render_set_camera.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_set_camera_matrix","description":"Set a manual camera for any target, no Unity or EGL hook. matrix is 16 COLUMN-MAJOR floats of projection * worldToCamera; camera_position controls distance labels; viewport is normalized bottom-left [x,y,width,height], default [0,0,1,1]. Positive clip W faces the camera.","inputSchema":{"type":"object","properties":{"matrix":{"type":"array","minItems":16,"maxItems":16,"items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0}},"camera_position":{"type":"array","items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"minItems":3,"maxItems":3},"viewport":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}}},"required":["matrix"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_project","description":"Project a world point to top-left pixels. Matrix cameras return immediately. WorldToScreenPoint fallback queues a game-frame query and returns pending/request_id; fetch render_projection_result. Never invokes Unity from an MCP thread.","inputSchema":{"type":"object","properties":{"position":{"type":"array","items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"minItems":3,"maxItems":3},"surface_width":{"type":"number","minimum":1,"maximum":32768},"surface_height":{"type":"number","minimum":1,"maximum":32768}},"required":["position","surface_width","surface_height"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_bind_update","description":"Explicitly Dobby-instrument a known, executing IL2CPP MonoBehaviour zero-argument void LateUpdate (preferred), Update or FixedUpdate. Sampling runs at its entry on the game thread, NOT in Java/GLES renderer. Uses weak handles and per-game-frame sampling (Time.frameCount deduplication when available); unavailable APIs return errors without affecting other tools. Only one binding; unbind before changing it.","inputSchema":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","minLength":1,"maxLength":96},"method":{"type":"string","enum":["LateUpdate","Update","FixedUpdate"]}},"required":["image","class","method"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_invoke","dobby"]},{"tool":{"name":"render_unbind_update","description":"Remove only the render-owned game-frame hook, release weak handles and expire live camera data. Manual objects/UI keep working.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_invoke","dobby"]},{"tool":{"name":"render_binding_status","description":"Read render frame hook address, sampling thread ID and last sample age. bound=true with no thread means the chosen method has not executed yet.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_find_objects","description":"Queue Unity FindObjectsOfType for a class; limit=0 (default) means all matches. include_inactive defaults true, matching the IL2CPP instance browser; older Unity may support active objects only. Requires frame binding, not a camera or enabled rendering. Returns acceptance, NOT completion; poll render_status.discovery_pending/discovery_error, then render_list_objects. Discovery allocates an array; large populations can be costly.","inputSchema":{"type":"object","properties":{"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","minLength":1,"maxLength":96},"limit":{"type":"integer","minimum":0,"maximum":2147483647},"include_inactive":{"type":"boolean","default":true}},"required":["image","class"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_invoke","il2cpp_objects"]},{"tool":{"name":"render_track_class","description":"Add/update continuous class discovery. Requires frame binding. Up to 16 classes; no fixed object capacity. limit=0 (default) means all matches. include_inactive defaults true, matching the IL2CPP instance browser. One class is rediscovered each game frame in rotation; legacy refresh_ms is accepted but ignored. Discovery preserves checkbox selections; select_new controls new objects. Returns acceptance; inspect render_list_tracked_classes for count_valid/pending/found/error and include_inactive_effective. IDs cannot be reassigned to a different class without untracking.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"image":{"type":"string","maxLength":256},"namespace":{"type":"string","maxLength":256},"class":{"type":"string","minLength":1,"maxLength":96},"limit":{"type":"integer","minimum":0,"maximum":2147483647},"include_inactive":{"type":"boolean","default":true},"select_new":{"type":"boolean"},"refresh_ms":{"type":"integer","minimum":1000,"maximum":60000}},"required":["id","image","class"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_invoke","il2cpp_objects"]},{"tool":{"name":"render_list_tracked_classes","description":"Read class filters and count_valid/pending/found/error. found=null before a successful scan or on failure, not zero; include_inactive_effective reports legacy Unity scope fallback. Counts are matching instances, not guaranteed drawable objects.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_untrack_class","description":"Stop a class tracker and remove only automatic entries exclusively owned by it. Explicit/manual objects survive.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_refresh_class","description":"Request refresh on the next bound game frame; inspect class status for completion.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_refresh_cameras","description":"Queue camera enumeration on the game thread. Falls back to FindObjectsOfType(Camera) if get_allCameras is stripped. Read render_list_cameras for cached names/addresses.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering","il2cpp_metadata","il2cpp_invoke","il2cpp_objects"]},{"tool":{"name":"render_projection_result","description":"Fetch an asynchronous render_project result. Requests are bounded to the latest 16; pending queries time out after five seconds without a game frame.","inputSchema":{"type":"object","properties":{"request_id":{"type":"integer","minimum":1,"maximum":9007199254740991}},"required":["request_id"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"overlay_set_panel","description":"Create/patch an ImGui panel in the Custom tab. New panels require id/title. Up to 8 panels. Existing settings are preserved for omitted fields; visible/order control layout. No script injection.","inputSchema":{"type":"object","properties":{"descriptor":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"visible":{"type":"boolean"},"order":{"type":"number","minimum":-1000,"maximum":1000},"title":{"type":"string","maxLength":256}},"required":["id"],"additionalProperties":false}},"required":["descriptor"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_set_widget","description":"Create/patch a widget: text/button/toggle/slider/select/input. New widgets require id/panel/type; panel must exist. Up to 64. Slider uses min/max/value; select uses options and a zero-based integer value. input uses Java EditText/system IME. Optional action uses an allowlisted native UI/render command and arguments with {value} (single token) or {value_hex} (UTF-8 text). action:null removes the binding. Saving never executes actions; only human interaction does. Poll overlay_ui_events for changes. Use debug_help for command syntax.","inputSchema":{"type":"object","properties":{"descriptor":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"visible":{"type":"boolean"},"order":{"type":"number","minimum":-1000,"maximum":1000},"panel":{"type":"string","minLength":1,"maxLength":96},"type":{"type":"string","enum":["text","button","toggle","slider","select","input"]},"label":{"type":"string","maxLength":256},"text":{"type":"string","maxLength":4096},"value":{"type":["number","boolean","string"],"maxLength":4096},"min":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"max":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"options":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","maxLength":256,"minLength":1}},"disabled":{"type":"boolean"},"color":{"type":"string","minLength":8,"maxLength":8,"pattern":"^[0-9a-fA-F]{8}$","description":"Eight hexadecimal RRGGBBAA digits; object 00000000 inherits the global color."},"action":{"type":["object","null"],"properties":{"command":{"type":"string","enum":["OVERLAY_SET","OVERLAY_WINDOW","OVERLAY_RESET","RENDER_STYLE","RENDER_CAMERA","RENDER_MATRIX","RENDER_OBJECT_ADD","RENDER_OBJECT_SET","RENDER_OBJECT_REMOVE","RENDER_OBJECT_POSITION","RENDER_OBJECT_BONES","RENDER_CLEAR","RENDER_FIND_OBJECTS","RENDER_TRACK_CLASS","RENDER_UNTRACK_CLASS","RENDER_REFRESH_CLASS","RENDER_BIND_UPDATE","RENDER_UNBIND_UPDATE","RENDER_REFRESH_CAMERAS"]},"arguments":{"type":"string","maxLength":4096}},"required":["command","arguments"],"additionalProperties":false}},"required":["id"],"additionalProperties":false}},"required":["descriptor"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_list_custom_ui","description":"Read shared custom panels and widgets, including current values; reflects both MCP and manual edits.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_remove_custom_ui","description":"Remove a custom widget or panel. Removing a panel also removes its widgets; built-in pages are unaffected.","inputSchema":{"type":"object","properties":{"kind":{"type":"string","enum":["panel","widget"]},"id":{"type":"string","minLength":1,"maxLength":96}},"required":["kind","id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_ui_events","description":"Read up to 128 recent manual widget interactions after a sequence number; does not consume events. Store latest_sequence for subsequent polling.","inputSchema":{"type":"object","properties":{"after_sequence":{"type":"integer","minimum":0,"maximum":9007199254740991}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_call_logs","description":"Read the latest 256 native MCP/UI calls with status, duration and bounded 2-KiB argument/result previews. In-memory only and independent of Toast.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_clear_call_logs","description":"Clear in-memory call history only; does not change Toast, hooks, objects or UI.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"render_set_primitive","description":"Create/patch a drawing primitive by ID. New entries require type/points; default space=screen. text/circle require 1 point, line/rect 2, triangle 3, quad/bezier 4, polyline 2..64, polygon/mesh 3..64. Mesh uses zero-based triangle indices (3..384 entries); polygon is outline-only. Cubic bezier uses projected control points. foreground selects foreground/background; clip_rect is normalized top-left [x,y,w,h]. Each point is [x,y,z]. Screen coordinates are normalized top-left (x/y; z ignored, components -4..4). World coordinates use the active camera and require valid projection. radius/font_size/thickness are pixels. filled applies to circle/rect/triangle/quad/mesh; closed to polyline. Up to 128 entries and 512 total world vertices. Screen graphics work without IL2CPP. Existing object styles/labels are not overwritten.","inputSchema":{"type":"object","properties":{"descriptor":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96},"visible":{"type":"boolean"},"order":{"type":"number","minimum":-1000,"maximum":1000},"type":{"type":"string","enum":["text","line","polyline","rect","circle","triangle","quad","polygon","bezier","mesh"]},"space":{"type":"string","enum":["screen","world"]},"points":{"type":"array","minItems":1,"maxItems":64,"items":{"type":"array","items":{"type":"number","minimum":-10000000.0,"maximum":10000000.0},"minItems":3,"maxItems":3}},"text":{"type":"string","maxLength":4096},"color":{"type":"string","minLength":8,"maxLength":8,"pattern":"^[0-9a-fA-F]{8}$","description":"Eight hexadecimal RRGGBBAA digits; object 00000000 inherits the global color."},"thickness":{"type":"number","minimum":0.5,"maximum":10},"font_size":{"type":"number","minimum":10,"maximum":96},"radius":{"type":"number","minimum":1,"maximum":4096},"filled":{"type":"boolean"},"closed":{"type":"boolean"},"foreground":{"type":"boolean"},"indices":{"type":"array","minItems":3,"maxItems":384,"items":{"type":"integer","minimum":0,"maximum":63}},"clip_rect":{"type":"array","minItems":4,"maxItems":4,"items":{"type":"number","minimum":0,"maximum":1}}},"required":["id"],"additionalProperties":false}},"required":["descriptor"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_list_primitives","description":"List custom drawing descriptors, including IDs, geometry and styles. Visibility still depends on renderer/camera availability.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_remove_primitive","description":"Remove one custom primitive without affecting object rendering.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"render_clear_primitives","description":"Clear all custom drawing primitives; leaves object registry, hooks and UI unchanged.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["rendering"]},{"tool":{"name":"workspace_browser","description":"Manage the manual IL2CPP search tabs without losing other searches. op=list/config/create/update/duplicate/remove/save/load/restore. Tab kind: 0 class, 1 method, 2 field. create accepts query fields; update needs the FULL tab from list, including decimal-string id/version for compare-and-swap. duplicate/remove use id; optional remove version. save/load require safe name<=48; restore requires config. Only pure queries persist; no object addresses, calls or hooks are replayed. Up to 512 tabs. Does not perform the search itself; use existing il2cpp search tools for results.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["list","config","create","update","duplicate","remove","save","load","restore"]},"tab":{"type":"object","properties":{"name":{"type":"string","maxLength":96},"image":{"type":"string","maxLength":256},"query":{"type":"string","maxLength":256},"class_filter":{"type":"string","maxLength":256},"kind":{"type":"integer","minimum":0,"maximum":2},"id":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20},"version":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20}},"required":[],"additionalProperties":false},"id":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20},"version":{"type":"string","pattern":"[1-9][0-9]{0,19}","maxLength":20},"name":{"type":"string","maxLength":48,"pattern":"[A-Za-z0-9_-]{1,64}"},"config":{"type":"object","properties":{"format":{"type":"string","enum":["il2cpp-workbench-queries"]},"schema":{"type":"integer","minimum":1,"maximum":1},"tabs":{"type":"array","items