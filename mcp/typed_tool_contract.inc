ION_FIND","IL2CPP_RELATION_RESULTS","MEMORY_MODULES","MEMORY_MODULE_FIND","MEMORY_ADDRESS_INFO","MEMORY_READ","MEMORY_SEARCH","MEMORY_SEARCH_FUZZY","MEMORY_SEARCH_TYPED","MEMORY_SEARCH_RESULTS","MEMORY_POINTER_SCAN_MT","MEMORY_CHAIN_SCAN","MEMORY_CHAIN_BATCH","ASM_STATUS","ASM_DISASSEMBLE","DECOMP_STATUS","DECOMP_DECOMPILE","DOBBY_LIST_HOOKS","DOBBY_TRACE_LIST","DOBBY_TRACE_HITS","DOBBY_TRACE_HIT","BREAKPOINT_STATUS","BREAKPOINT_LIST","BREAKPOINT_HITS","BREAKPOINT_BACKTRACE"]},"arguments":{"type":"string","maxLength":60000},"include_result":{"type":"boolean"}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"journal_status","description":"Read persistent root-journal health, current exact session filename, client session, async queue counters and write failures. Does not create, clear or delete logs.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"journal_query","description":"List persistent journal session files or read one bounded page. op=list uses cursor/limit; op=read uses the exact session filename plus byte cursor/limit and optional kind/command/failures_only filters. Preserve next_cursor and snapshot_bytes as decimal strings. A read page scans at most 256 KiB and returns at most 100 records/48 KiB; has_more requires another explicit call. Filesystem list ordering can change after refresh. This tool never clears logs.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["list","read"]},"session":{"type":"string","minLength":1,"maxLength":160,"pattern":"session-[0-9]+-[0-9]+-[0-9]+(?:-part-[1-9][0-9]*)?\\.jsonl","description":"Exact journal session filename returned by journal_status or journal_query list."},"cursor":{"type":"string","minLength":1,"maxLength":20,"pattern":"(?:0|[1-9][0-9]{0,19})","description":"Exact decimal next_cursor returned by journal_query; never a JSON number."},"limit":{"type":"integer","minimum":1,"maximum":100},"kind":{"type":"string","maxLength":64},"command":{"type":"string","maxLength":128},"failures_only":{"type":"boolean"}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"journal_export","description":"Copy one exact persistent journal session (current session when omitted) to a new root-owned, target-scoped JSONL file under /data/adb/zygisk_il2cpp_mcp/journal/<target>/exports/. Returns a receipt/path/byte count, never file contents, never overwrites or deletes an existing log.","inputSchema":{"type":"object","properties":{"session":{"type":"string","minLength":1,"maxLength":160,"pattern":"session-[0-9]+-[0-9]+-[0-9]+(?:-part-[1-9][0-9]*)?\\.jsonl","description":"Exact journal session filename returned by journal_status or journal_query list."}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"diagnostic_export","description":"Create a new root-owned, target-scoped bounded diagnostic JSON bundle under /data/adb/zygisk_il2cpp_mcp/journal/<target>/exports/ for one exact journal session (current session when omitted). Includes journal/backend/module/OS diagnostics and a bounded recent event tail; excludes raw memory and system-wide crash logs. Returns only a receipt/path.","inputSchema":{"type":"object","properties":{"session":{"type":"string","minLength":1,"maxLength":160,"pattern":"session-[0-9]+-[0-9]+-[0-9]+(?:-part-[1-9][0-9]*)?\\.jsonl","description":"Exact journal session filename returned by journal_status or journal_query list."}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"debug_project","description":"Persistent target-version-scoped debug projects. op=list pages IDs with after/limit; create accepts optional safe id plus data; get reads a full project; update merges supplied data and requires the exact revision; archive irreversibly marks the project archived and requires its exact revision; summary returns bounded resume fields without replay; export creates a new target-private JSON file. Projects persist symbolic notes/configuration only and never replay execution or trust saved live addresses after restart.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["list","create","get","update","archive","summary","export"]},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"after":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}","description":"Exact next_after value from the preceding page."},"limit":{"type":"integer","minimum":1,"maximum":100},"revision":{"type":"string","minLength":1,"maxLength":16,"pattern":"[1-9][0-9]{0,15}","description":"Exact decimal revision returned by debug_project; never a JSON number."},"data":{"type":"object","properties":{"title":{"type":"string","maxLength":256},"goal":{"type":"string","maxLength":8192},"notes":{"type":"string","maxLength":16384},"tasks":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256},"findings":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256},"bookmarks":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256},"artifacts":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256},"next_actions":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256},"observations":{"type":"array","items":{"type":["object","array","string","number","boolean","null"],"maxLength":60000},"maxItems":256}},"additionalProperties":false}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"debug_snapshot","description":"Persistent bounded debug snapshots. op=capture kind=object/list/dict/dictionary queues an IL2CPP game-frame capture (limit 1..256, offset 0..10000); object pagination uses a global breadth-first field ordinal, and each page is a fresh capture. kind=memory performs a checked memory read and accepts size instead of limit/offset. Historical addresses are records, not reusable identities. list pages IDs with after/limit (limit 1..100); get reads one; diff compares before/after_id with offset 0..65536 and limit 1..256 and requires allow_cross_session=true for differing sessions/targets. Memory diff covers all saved bytes in address order. export creates a target-private JSON file. Inspect next_offset, has_more, partial and stop_reasons; snapshots are not coherent whole-process snapshots.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["capture","list","get","diff","export"]},"kind":{"type":"string","enum":["object","list","dict","dictionary","memory"]},"address":{"type":["string","integer"],"description":"Hexadecimal or decimal address; 0 selects a manual object."},"label":{"type":"string","maxLength":256},"project":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"size":{"type":"integer","minimum":1,"maximum":65536},"depth":{"type":"integer","minimum":0,"maximum":4},"limit":{"type":"integer","minimum":1,"maximum":256,"description":"Operation-specific item limit: IL2CPP capture and diff accept 1..256; list accepts 1..100. It is not accepted by get/export or memory capture."},"offset":{"type":"integer","minimum":0,"maximum":65536,"description":"Operation-specific start offset: IL2CPP capture accepts 0..10000 (global breadth-first field ordinal for object, item index for list/dictionary); diff accepts 0..65536 changed entries. It is not accepted by list/get/export or memory capture."},"budget_ms":{"type":"integer","minimum":1,"maximum":100},"after":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}","description":"Exact next_after value from the preceding page."},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"before":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"after_id":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"allow_cross_session":{"type":"boolean"}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"change_history","description":"Persistent bridge memory-write/code-patch history. op=list pages redacted summaries with after/limit; get reads one full record; export creates a target-private JSON file; undo requires id, the exact current session returned by list/get, and confirm=true. Undo revalidates session, backend, mapping and current bytes, refuses frozen/conflicting addresses, and is not a general transaction rollback.","inputSchema":{"type":"object","properties":{"op":{"type":"string","enum":["list","get","export","undo"]},"id":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}"},"after":{"type":"string","minLength":1,"maxLength":64,"pattern":"[A-Za-z0-9_-]{1,64}","description":"Exact next_after value from the preceding page."},"limit":{"type":"integer","minimum":1,"maximum":100},"session":{"type":"string","minLength":3,"maxLength":41,"pattern":"[1-9][0-9]{0,19}-[1-9][0-9]{0,19}","description":"Exact opaque session string returned by change_history; never normalize or reuse it."},"confirm":{"type":"boolean"}},"required":["op"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"debug_stop_all","description":"Stop or pause all managed repeating debug work: debugger-owned paused threads, freezes, traces, sampling breakpoints, Frida tasks, native logic and UI programs. Requires confirm=true. This is best-effort per component and does NOT restore memory changes, remove retained instrumentation, undo accepted game calls or revert arbitrary hook side effects.","inputSchema":{"type":"object","properties":{"confirm":{"type":"boolean"}},"required":["confirm"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true,"openWorldHint":false}},"features":["diagnostics"]},{"tool":{"name":"native_library_inject","description":"Upload a local SO from the MCP SERVER machine and load it in the already connected target (not an arbitrary PID or an offline app). No ADB file transfer required. Validates ELF ABI and transfer CRC32; optional expected_sha256 checks the local file. Requires allow_execute=true: constructors, and optionally JNI_OnLoad, execute in the target and CAN CRASH/HANG IT; unlike decompilation this cannot be isolated. Default RTLD_LOCAL; preload dependencies separately with global_symbols=true if needed. Returns an operation ID; if pending, poll native_library_status, NEVER reinject just because the wait expired. No automatic dlclose/unload. Loading does not grant access to Android-private dependency libraries.","inputSchema":{"type":"object","properties":{"path":{"type":"string","minLength":1,"maxLength":4096},"allow_execute":{"type":"boolean","enum":[true]},"expected_sha256":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"call_jni_onload":{"type":"boolean","default":false},"global_symbols":{"type":"boolean","default":false},"wait_seconds":{"type":"number","minimum":0,"maximum":30,"default":5}},"required":["path","allow_execute"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["native_libraries"]},{"tool":{"name":"native_library_status","description":"List custom SO operations and target ABI, or inspect an operation ID. Reports received bytes, loading/loaded/failed state and full linker/JNI error. Read-only, remains available during a hanging constructor. Loaded code is pinned until process exit. Decompiler SO is managed separately by decompiler_status.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":96}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["native_libraries"]},{"tool":{"name":"unreal_render","description":"Connect Unreal actors/SceneComponents to the Java renderer. action=status returns camera diagnostics, shared discovery cursor and sampling health: fresh_objects/valid_samples count all fresh enabled UE entries; stale_objects/invalid_objects/deferred_objects and sample_duration_ms distinguish expiry, failure and budget deferral. Tracked matches_seen is the last completed pass when count_valid=true; scan_matches is current progress. All tracked classes share one scan. Mutations require confirm=true: add/remove one object; track/untrack a class including derived instances; refresh restarts shared discovery without clearing completed counts or existing render entries; auto_camera finds local PlayerController -> LocalPlayer -> PlayerCameraManager; camera selects a validated manager; clear removes UE entries only. No UE function calls/hooks. Unsupported camera/socket/bone layouts are disabled with reasons. Coordinates convert cm/Z-up to metres/Y-up. Existing render tools manage styles and objects; no texture/model extraction.","inputSchema":{"type":"object","properties":{"action":{"type":"string","enum":["status","add","remove","track","untrack","refresh","auto_camera","camera","clear"]},"address":{"type":"string","minLength":1,"maxLength":20},"confirm":{"type":"boolean","default":false},"expected_revision":{"type":"string","minLength":1,"maxLength":20}},"required":["action"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","rendering","memory_read"]},{"tool":{"name":"unreal_status","description":"Read the independent Unreal backend status, process-lifetime configuration revision, capability flags and a proposed ARM64 FNamePool/FProperty layout template. No engine initialization, code loading or game function calls. Filename module hints are not engine proof.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_read"]},{"tool":{"name":"unreal_help","description":"Explain Unreal discovery/configuration, root addresses, exact build layout overrides, pagination, guarded writes, and unsupported capabilities. Does not invoke UE or IL2CPP.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal"]},{"tool":{"name":"unreal_discover","description":"Bounded read-only ELF RW segment scan proposing FNamePool and chunked UObject array roots with identity/name evidence. Does NOT commit. Default scans likely UE module names; set module explicitly for renamed engines. Empty/partial results are not proof of absence; use confirmed roots/custom offsets when needed.","inputSchema":{"type":"object","properties":{"module":{"type":"string","maxLength":1024},"scan_mb":{"type":"integer","minimum":1,"maximum":64,"default":16},"timeout_ms":{"type":"integer","minimum":10,"maximum":2000,"default":1000}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_maps","memory_read"]},{"tool":{"name":"unreal_configure","description":"Trial an exact ARM64 FNamePool/FProperty profile with confirmed object_array and name_pool addresses. object_array points to FChunkedFixedUObjectArray itself, not its GUObjectArray wrapper. confirm=false only validates; confirm=true requires expected_revision from unreal_status and atomically commits only a passing profile. Failed trials preserve active state. No persistence/replay after restart. A root-only validation enables object search but not unvalidated reflected writes.","inputSchema":{"type":"object","properties":{"profile":{"type":"object","properties":{"label":{"type":"string","maxLength":128},"engine_version":{"type":"string","maxLength":128},"object_array":{"type":"string","minLength":1,"maxLength":20},"name_pool":{"type":"string","minLength":1,"maxLength":20},"offsets":{"type":"object","maxProperties":64,"additionalProperties":{"type":"integer","minimum":0,"maximum":1048576}}},"required":["object_array","name_pool"],"additionalProperties":false},"confirm":{"type":"boolean","default":false},"expected_revision":{"type":"string","maxLength":20,"minLength":1},"timeout_ms":{"type":"integer","minimum":10,"maximum":2000,"default":1000}},"required":["profile"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_read"]},{"tool":{"name":"unreal_search","description":"Page UE objects/classes/functions/actors/components. class_filter is one exact class name/address; alternatively class_filters supplies 1..64 OR filters (including derived classes) in ONE scan. Each result includes matched_class_filters; overlapping classes do not duplicate objects. outer_filter selects directly owned objects (not a scene attachment tree). Continue at next_index even with empty items; read_operations/read_bytes expose bounded scan cost. Cheap candidate filtering precedes full identity validation of every returned object. include_defaults=false excludes CDOs. Not a stop-the-world snapshot; no engine calls.","inputSchema":{"type":"object","properties":{"kind":{"type":"string","enum":["objects","classes","functions","actors","components"],"default":"objects"},"query":{"type":"string","maxLength":1024},"class_filter":{"type":"string","maxLength":1024},"class_filters":{"type":"array","minItems":1,"maxItems":64,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":1024}},"outer_filter":{"type":"string","minLength":1,"maxLength":20},"start_index":{"type":"integer","minimum":0,"maximum":10000000,"default":0},"limit":{"type":"integer","minimum":1,"maximum":256,"default":50},"timeout_ms":{"type":"integer","minimum":10,"maximum":2000,"default":250},"include_defaults":{"type":"boolean","default":true,"description":"Include class default objects (CDOs). false shows only non-default instances."}},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_read"]},{"tool":{"name":"unreal_object_context","description":"Read an identity-checked UE object's Outer ownership chain, reflected class inheritance, and paged DIRECT owned children. Outer is not AttachParent and this does not enumerate an entire scene. Chains have address/name/class/view for inspector navigation; children use next_index/has_more (continue even if empty). depth bounds ancestors; include_children=false avoids scanning. Optional expected_serial/expected_revision reject old identities/profiles. Partial chains expose chain_issue; no engine calls or writes.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":20},"depth":{"type":"integer","minimum":0,"maximum":32,"default":16},"include_children":{"type":"boolean","default":true},"start_index":{"type":"integer","minimum":0,"maximum":10000000,"default":0},"limit":{"type":"integer","minimum":1,"maximum":256,"default":32},"expected_serial":{"type":"integer","minimum":0,"maximum":2147483647},"expected_revision":{"type":"string","minLength":1,"maxLength":20},"timeout_ms":{"type":"integer","minimum":10,"maximum":2000,"default":1000}},"required":["address"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_read"]},{"tool":{"name":"unreal_resolve_path","description":"Resolve a READ-ONLY live reflected UE field path, e.g. RootComponent.RelativeLocation.X or Inventory[3].Owner.Health. Up to 32 named steps, Object/Class references, inline structs, fixed arrays and TArray indexing. Returns per-step declaring class/property, field offset, element offset, actual storage address and typed value/object navigation data. Validates container bounds, UObject identities, descriptors, pointer links and array headers; null/out-of-range/changed/unsupported paths fail explicitly. Never invokes getters, allocates or writes game data. expected_serial/expected_revision optionally reject stale roots/profiles. This is exact path loading, not exhaustive relationship discovery.","inputSchema":{"type":"object","properties":{"address":{"type":"string","minLength":1,"maxLength":20},"path":{"type":"string","minLength":1,"maxLength":1024},"expected_serial":{"type":"integer","minimum":0,"maximum":2147483647},"expected_revision":{"type":"string","minLength":1,"maxLength":20},"timeout_ms":{"type":"integer","minimum":10,"maximum":2000,"default":1000}},"required":["address","path"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["unreal","memory_read"]},{"tool":{"name":"unreal_type_members","description":"Read one reflected UClass or ScriptStruct's inherited FProperty names/types/offsets/array dimensions and UFunctions. Native addresses are executable candi