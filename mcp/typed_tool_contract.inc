ring","number","boolean","null"],"maxLength":4096}},"required":["id","value"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui"]},{"tool":{"name":"overlay_program_set","description":"Create/patch a Lua UI program. Define function on_frame(ctx). ctx has objects, game_frame, time_ms, delta_ms, selection, variables, events and async results. ui.window/node/variable/remove and render.primitive/remove emit validated descriptors. Local IDs become program:<id>:<localId> (localId <=48 bytes); events return local node IDs. State persists until restart. No io/os/ffi/package/debug/JIT; 8 MiB, 100k Lua instructions, cooperative 12ms budget and 128 operations/frame. Errors stop only this program. New programs default stopped; enabled=true starts. runtime.call(command,args) requires explicit allow_game_actions=true and the frame queue allowlist. Presets always restore programs stopped and revoke this grant.","inputSchema":{"type":"object","properties":{"descriptor":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":32,"pattern":"[^:]+"},"source":{"type":"string","minLength":1,"maxLength":65536},"enabled":{"type":"boolean"},"allow_game_actions":{"type":"boolean"}},"required":["id"],"additionalProperties":false}},"required":["descriptor"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","lua","rendering"]},{"tool":{"name":"overlay_program_list","description":"Read UI programs, running/error status, frame cost, memory and recent print logs. No source code returned.","inputSchema":{"type":"object","properties":{},"required":[],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false,"openWorldHint":false}},"features":["overlay_ui","lua","rendering"]},{"tool":{"name":"overlay_program_get","description":"Read a UI program including its Lua source and 